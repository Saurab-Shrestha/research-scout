DATABASE_URL=postgresql+psycopg://localhost/research_scout
# Sent in the User-Agent and to OpenAlex's polite pool
CONTACT_EMAIL=
# Free key with $1/day budget: https://openalex.org/settings/api
OPENALEX_API_KEY=
# Vertex AI express mode: true + GOOGLE_API_KEY. Gemini Developer API: false + GOOGLE_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_API_KEY=
EXTRACTION_MODEL=gemini-3.8-flash
# Optional: prices for job cost reporting (from your Vertex AI pricing page)
LLM_USD_PER_MILLION_INPUT=
LLM_USD_PER_MILLION_OUTPUT=
GROUNDED_SEARCH_USD_EACH=
# docker compose only
POSTGRES_PASSWORD=
