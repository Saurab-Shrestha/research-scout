# Copy to .env. With Docker, only POSTGRES_PASSWORD is required; set the AI provider in the app
# (Settings → AI provider). Values here are defaults the app settings override.

# docker compose only
POSTGRES_PASSWORD=

# Local development without Docker
DATABASE_URL=postgresql+psycopg://localhost/research_scout

# OpenAlex (finding researchers). Optional free key with a daily budget: https://openalex.org/settings/api
OPENALEX_API_KEY=
# Sent in the User-Agent and to OpenAlex's polite pool when there is no key
CONTACT_EMAIL=

# AI provider defaults: gemini | openai | anthropic | openai_compatible
LLM_PROVIDER=gemini
# Empty uses the provider's default model
EXTRACTION_MODEL=
GOOGLE_API_KEY=
# true for Vertex AI express mode, false for a Google AI Studio key
GOOGLE_GENAI_USE_VERTEXAI=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# e.g. http://localhost:11434/v1 for Ollama (http://host.docker.internal:11434/v1 from Docker)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# gemini | openai | openai_compatible (Anthropic has no embeddings)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=

# Optional: prices for job cost reporting, from your provider's pricing page
LLM_USD_PER_MILLION_INPUT=
LLM_USD_PER_MILLION_OUTPUT=
GROUNDED_SEARCH_USD_EACH=
